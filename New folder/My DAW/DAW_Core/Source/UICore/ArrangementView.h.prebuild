#pragma once
#include <JuceHeader.h>
#include <unordered_set>
#include <limits>
#include <vector>
#include "../ThemeCore/Theme.h"
#include "../TrackCore/Track.h"
#include "../ClipCore/Clip.h"
#include "../StateCore/ApplicationState.h"
#include "../MarkerCore/MarkerManager.h"
#include "../TransportCore/TransportController.h"
#include "../CommandCore/ClipCommands.h"
#include "../CommandCore/GeneralCommands.h"
#include "../CommandCore/CommandManager.h"
#include "../AudioEngineCore/AudioFileManager.h"
#include "TrackColorPalette.h"
#include "../MidiCore/MidiClip.h"
#include "../AutomationCore/AutomationManagerCore.h"
#include "../AutomationCore/LastTouchedPluginParameterCore.h"
#include "../Automation/AutomationArrangementBridgeCore.h"
#include "../Automation/AutomationParameterKeyCore.h"
#include "../PluginHostCore/PluginChainCore.h"
#include "../BubblegumSelectionCore/BubblegumSelectionOverlayComponent.h"

namespace DAW {

inline constexpr double kAutoFadeOnSplitMs = 4.0;

/** Snap resolution for clip movement. Free = no snapping. */
enum class SnapMode { Free, Note_1_32, Note_1_16, Note_1_8, Note_1_4, Note_1_2, Bar_1, Bar_2, Bar_4 };
enum class EditTool { Select, Blade, RazorEdit, Eraser, Mute };

/** TrackLane class definition */
// --- TrackLane ---
// One horizontal lane per track. Renders clips, handles clip editing.
class TrackLane : public juce::Component,
                  public Track::Listener,
                  public Clip::Listener,
                  private juce::Timer
{
public:
    static constexpr float kStripW = 11.f; // color strip width — clips and grid start after this
    static constexpr float kClipEdgeHitW = 14.f;
    static constexpr int   kBodyDragStartThresholdPx = 5;
    static constexpr int   kEdgeResizeStartThresholdPx = 5;

    enum class BodyDragAxis { Undecided, Horizontal, Vertical };
    enum class ClipDragMode { None, HeightResize, ClipLeftEdge, ClipRightEdge, ClipBody, ClipFadeIn, ClipFadeOut };

    TrackLane(Track& track, ClipManager& clipManager,
              ApplicationState& state, TransportController& transport,
              AudioFileManager* audioFiles = nullptr,
              AutomationManagerCore* automation = nullptr)
        : track_(track), clipManager_(clipManager), state_(state),
          transport_(transport), audioFiles_(audioFiles), automation_(automation)
    {
        markers_ = nullptr;
        setWantsKeyboardFocus(true);
        track_.addListener(this);
        syncClipListeners();
    }

    ~TrackLane() override
    {
        clearClipListeners();
        track_.removeListener(this);
    }

    Track& getTrack() { return track_; }
    int getLaneIndex() const { return laneIndex_; }

    // Track::Listener — instant repaint on color/name change + sync clip colors
    void trackPropertyChanged(Track*) override
    {
        // Auto-sync clip colors to track color (including palette preview)
        auto trackCol = track_.getColor().brighter(0.1f);
        for (auto* clip : clipManager_.getClipsOnTrack(track_.getID()))
            clip->setColor(trackCol);
        repaint();
    }

    void clipPropertyChanged(Clip* clip) override
    {
        if (clip != nullptr && clip->getTrackID() == track_.getID())
            repaint();
    }

    void setZoomAndScroll(double pxPerSample, double scrollX)
    { pxPerSample_ = pxPerSample; scrollX_ = scrollX; gridCacheDirty_ = true; }

    void setWaveformDetailEnabled(bool enabled)
    {
        if (waveformDetailEnabled_ == enabled)
            return;
        waveformDetailEnabled_ = enabled;
        repaint();
    }

    void setTempo(double bpm)             { bpm_ = juce::jmax(1.0, bpm); gridCacheDirty_ = true; }
    void setSampleRate(double sr)         { sampleRate_ = juce::jmax(1.0, sr); gridCacheDirty_ = true; }
    void setFastScrollMode(bool fast)     { fastScrollMode_ = fast; }
    void setSnapMode(SnapMode m)          { snapMode_ = m; }
    void setLockHorizontal(bool on)       { lockHorizontal_ = on; }
    void setRecordStartPos(SamplePosition p) { recordStartPos_ = p; }
    juce::Colour getTrackColor() const    { return track_.getColor(); }
    int  getDesiredHeight() const         { return height_; }
    void setDesiredHeight(int h)          { height_ = juce::jlimit(24, 2000, h); }
    void setLaneIndex(int idx)            { laneIndex_ = idx; }

    // Accessors for ArrangementView box-selection hit testing
    double getPxPerSample() const noexcept { return pxPerSample_; }
    double getScrollX()     const noexcept { return scrollX_; }
    double getTimelineLengthForClipPublic(const Clip& clip) const { return getTimelineLengthForClip(clip); }

    struct DuplicateGhostRect
    {
        TrackID trackId;
        float x = 0.f;
        float width = 0.f;
        bool horizontalMode = false;
    };

    const std::vector<DuplicateGhostRect>& getDuplicateGhostRects() const noexcept { return duplicateGhostRects_; }
    bool hasDuplicateGhosts() const noexcept { return duplicateSpawned_ && !duplicateGhostRects_.empty(); }

    void setMultiSelectedClipIDs(const std::unordered_set<juce::String>& ids)
    {
        multiSelectedClipIDs_ = ids;
        repaint();
    }
    bool isClipMultiSelected(const juce::String& id) const
    {
        return multiSelectedClipIDs_.count(id) > 0;
    }

    std::function<void(TrackLane*, int)>  onHeightDrag;
    std::function<void(Clip*, int)>       onClipCrossLane; // clip, screenY
    std::function<void(Clip*, const std::vector<std::pair<ClipID, TrackID>>&, int)> onGroupClipCrossLane;
    std::function<juce::Colour(int)>      onGetDragPreviewColor; // screenY -> preview track color
    std::function<void(float)>            onRequestAutoScroll;   // deltaPx
    std::function<void(TrackLane*, juce::Point<float>)> onBubblegumSelectionBegin;
    std::function<void(TrackLane*, juce::Point<float>)> onBubblegumSelectionDrag;
    std::function<void()>                 onBubblegumSelectionEnd;
    std::function<void(MidiClip&)>        onOpenMidiClip;
    std::function<void(Clip&)>            onOpenClipProperties;
    std::function<EditTool()>             onGetEditTool;
    std::function<void()>                 onClearClipSelection; // called when empty-lane click clears clips
    std::function<std::vector<DuplicateGhostRect>()> onGetDuplicateGhosts;
    std::function<void()>                 onRepaintAllLanes;    // request all lanes repaint (multi-ghost)
    std::function<juce::ValueTree()>      onGetClipboard;       // shared clipboard read
    std::function<void(juce::ValueTree)>  onSetClipboard;       // shared clipboard write
    std::function<PluginChainCore*(const TrackID&)> onGetPluginChain;
    std::function<RoutingGraph*()>        onGetRoutingGraph;

    void paint(juce::Graphics& g) override
    {
        syncClipListeners();

        auto& t       = Theme::getInstance();
        auto  b       = getLocalBounds().toFloat();
        const bool master = track_.isMaster();

        // ── Background ──────────────────────────────────────────────────────
        if (master)
        {
            g.setColour(t.colors.backgroundDark.darker(0.18f));
            g.fillRect(b);
            g.setColour(juce::Colour(0xFFCC9900).withAlpha(0.9f)); // gold top separator
            g.fillRect(0.f, 0.f, b.getWidth(), 3.f);
        }
        else
        {
            g.setColour(laneIndex_ % 2 == 0 ? t.colors.trackLane : t.colors.trackLane.brighter(0.04f));
            g.fillRect(b);
        }

        // ── Color strip ──────────────────────────────────────────────────────
        colorStripBounds_ = juce::Rectangle<float>(0.f, 0.f, kStripW, (float)getHeight());
        if (master)
        {
            g.setColour(juce::Colour(0xFFCC9900));
            g.fillRect(colorStripBounds_);
            g.setFont(juce::Font(7.5f, juce::Font::bold));
            g.setColour(juce::Colours::black.withAlpha(0.70f));
            g.drawText("M", colorStripBounds_.toNearestInt(), juce::Justification::centred);
        }
        else
        {
            g.setColour(track_.getColor());
            g.fillRect(colorStripBounds_);
        }
        // 1px separator between strip and timeline content
        g.setColour(t.colors.backgroundDark.withAlpha(0.5f));
        g.fillRect(kStripW, 0.f, 1.f, (float)getHeight());

        // All timeline content (grid + clips) is clipped to stay right of the color strip
        g.saveState();
        g.reduceClipRegion((int)kStripW, 0, getWidth() - (int)kStripW, getHeight());

        paintCachedGrid(g);

        // MASTER: crisp pinned label + large subtle watermark
        if (master)
        {
            // Crisp label pinned to top-left of the timeline area — always visible
            g.setFont(juce::Font(10.f, juce::Font::bold));
            g.setColour(juce::Colour(0xFFCC9900).withAlpha(0.90f));
            g.drawText("MASTER", (int)kStripW + 4, 4, 60, 14,
                       juce::Justification::centredLeft);
            // Large subtle watermark in the body
            g.setFont(juce::Font(t.fonts.bold.getHeight() * 2.2f, juce::Font::bold));
            g.setColour(juce::Colour(0xFFCC9900).withAlpha(0.11f));
            g.drawText("MASTER", (int)kStripW + 14, 0,
                       getWidth() - (int)kStripW - 14, getHeight(),
                       juce::Justification::centredLeft);
        }

        for (auto* clip : clipManager_.getClipsOnTrack(track_.getID()))
        {
            // Clips start at kStripW (after color strip) — timeline origin is at kStripW
            float cx = (float)(clip->getStartPosition() * pxPerSample_ - scrollX_) + kStripW;
            float cw = (float)(getTimelineLengthForClip(*clip) * pxPerSample_);
            if (cx + cw < kStripW || cx > (float)getWidth()) continue;
            juce::Rectangle<float> cr(cx, 4.f, cw, (float)getHeight() - 8.f);
            bool sel      = (state_.selectedClipID.getValue().toString() == clip->getID());
            bool multiSel = isClipMultiSelected(clip->getID());
            bool anySelected = sel || multiSel;
            // Use the clip's own colour. During drag, preview can temporarily override it.
            juce::Colour clipCol = (draggedClip_ == clip && dragPreviewColor_.getAlpha() > 0)
                                   ? dragPreviewColor_ : clip->getColor();
            const bool showClipName = !fastScrollMode_ && cw > 18.f;
            const float nameBarH = showClipName ? juce::jmin(14.0f, cr.getHeight() - 6.0f) : 0.0f;
            if (clip->isMuted())
            {
                g.setColour(clipCol.withAlpha(0.22f));
                g.fillRoundedRectangle(cr, 4.f);
                juce::Path hatch;
                for (float hx = cr.getX() - cr.getHeight(); hx < cr.getRight(); hx += 9.f)
                { hatch.startNewSubPath(hx, cr.getBottom()); hatch.lineTo(hx + cr.getHeight(), cr.getY()); }
                g.setColour(clipCol.withAlpha(0.18f));
                g.strokePath(hatch, juce::PathStrokeType(1.f));
                g.setColour(t.colors.border.withAlpha(0.35f));
                g.drawRoundedRectangle(cr, 4.f, 1.f);
            }
            else
            {
                g.setColour(clipCol.withAlpha(anySelected ? 0.95f : 0.85f));
                g.fillRoundedRectangle(cr, 4.f);
                if (!fastScrollMode_)
                {
                    juce::ColourGradient spec(juce::Colours::white.withAlpha(0.10f), 0, cr.getY(),
                                              juce::Colours::transparentBlack, 0, cr.getY() + 10.f, false);
                    g.setGradientFill(spec);
                    g.fillRoundedRectangle(cr, 4.f);
                }

                // Waveform overlay (if audio data is loaded for this clip)
                if (waveformDetailEnabled_ && audioFiles_ && audioFiles_->hasAudio(clip->getID()))
                {
                    g.saveState();
                    g.reduceClipRegion(cr.toNearestIntEdges());
                    auto sourceRate = audioFiles_->getSourceSampleRate(clip->getID());
                    auto sourceSpan = (SamplePosition)std::round((double)clip->getLength() * sourceRate / sampleRate_);
                    auto waveformBounds = cr.reduced(2.f, 4.f);
                    if (nameBarH > 0.0f)
                        waveformBounds.removeFromTop(nameBarH + 2.0f);

                    AudioFileManager::WaveformVisualOptions visual;
                    if (auto* audioClip = dynamic_cast<AudioClip*>(clip))
                    {
                        visual.gainLinear = audioClip->getGain();
                        visual.pitchSemitones = audioClip->getPitch();
                        visual.timeStretchRatio = audioClip->getTimeStretch();
                        visual.reversed = audioClip->isReversed();
                        visual.clipTimelineSamples = audioClip->getLength();
                        visual.fadeInSamples = audioClip->getFadeInLength();
                        visual.fadeOutSamples = audioClip->getFadeOutLength();
                    }

                    audioFiles_->drawWaveform(clip->getID(), g,
                        waveformBounds,
                        clip->getSourceOffset(), sourceSpan,
                        juce::Colours::white.withAlpha(0.65f), visual);
                    g.restoreState();
                }

                // Left accent stripe
                if (!fastScrollMode_)
                {
                    g.setColour(clipCol.darker(0.25f).withAlpha(0.9f));
                    g.fillRect(cr.getX(), cr.getY() + 2.f, 3.f, cr.getHeight() - 4.f);
                }

                // Draw fade in/out AFTER waveform and BEFORE border
                if (auto* audioClip = dynamic_cast<AudioClip*>(clip))
                    drawClipFades(g, cr, *audioClip);

                if (anySelected)
                {
                    // Neon magenta selection — electric #FF0090 glow, black-glass DAW aesthetic
                    // Wide outer bloom
                    g.setColour(juce::Colour(0xFFFF0090).withAlpha(0.22f));
                    g.drawRoundedRectangle(cr.expanded(3.5f), 6.0f, 4.0f);
                    // Mid halo
                    g.setColour(juce::Colour(0xFFFF0090).withAlpha(0.50f));
                    g.drawRoundedRectangle(cr.expanded(1.2f), 5.0f, 1.8f);
                    // Inner crisp line — brighter for single-selected, slightly dimmer for multi
                    g.setColour(juce::Colour(multiSel && !sel ? 0xFFFF40B0 : 0xFFFF00AA));
                    g.drawRoundedRectangle(cr, 4.f, 1.1f);
                }
                else
                {
                    g.setColour(t.colors.clipBorder);
                    g.drawRoundedRectangle(cr, 4.f, 1.5f);
                }
            }
            if (showClipName)
            {
                auto nameBar = juce::Rectangle<float>(cr.getX() + 1.f, cr.getY() + 1.f,
                                                      juce::jmax(1.0f, cr.getWidth() - 2.f), nameBarH);
                g.setColour(juce::Colours::black.withAlpha(0.28f));
                g.fillRoundedRectangle(nameBar, 3.f);
                g.setColour(clip->isMuted() ? t.colors.textDisabled : juce::Colours::white);
                g.setFont(t.fonts.small);
                g.drawText(clip->getName(), nameBar.reduced(6.f, 0.f), juce::Justification::centredLeft, true);
            }

            if (clip->getType() == ClipType::MIDI && cw > 28.f)
            {
                auto pr = juce::Rectangle<float>(cr.getRight() - 24.f, cr.getY() + 4.f, 18.f, 14.f);
                g.setColour(t.colors.surface.withAlpha(0.72f));
                g.fillRoundedRectangle(pr, 3.f);
                g.setColour(t.colors.accent.withAlpha(0.75f));
                g.drawRoundedRectangle(pr, 3.f, 1.f);
                g.setColour(t.colors.text);
                g.setFont(juce::Font(9.f, juce::Font::plain));
                g.drawText(juce::CharPointer_UTF8("\xF0\x9F\x8E\xB9"), pr.toNearestInt(), juce::Justification::centred, false);
            }
        }

        const auto activeTool = onGetEditTool ? onGetEditTool() : EditTool::Select;
        if (showToolGuide_ && activeTool == EditTool::Blade && hoverToolX_ >= kStripW)
        {
            g.setColour(t.colors.accent.withAlpha(0.95f));
            g.fillRect(hoverToolX_ - 0.5f, 0.f, 1.5f, (float)getHeight());
            g.fillRect(hoverToolX_ - 4.f, 2.f, 9.f, 2.f);
            g.fillRect(hoverToolX_ - 4.f, (float)getHeight() - 4.f, 9.f, 2.f);
        }

        // ── Real-time recording indicator + live waveform ───────────────────
        if (!master && transport_.isRecording() && track_.isArmed())
        {
            const auto startPos = recordStartPos_;
            const auto curPos   = transport_.getPosition();
            if (curPos > startPos)
            {
                float rx = (float)(startPos * pxPerSample_ - scrollX_) + kStripW;
                float rw = (float)((curPos - startPos) * pxPerSample_);
                if (rx + rw > kStripW && rx < (float)getWidth())
                {
                    juce::Rectangle<float> rr(rx, 4.f, rw, (float)getHeight() - 8.f);

                    // Background fill
                    g.setColour(juce::Colour(0xFFCC2222).withAlpha(0.38f));
                    g.fillRoundedRectangle(rr, 4.f);

                    // Live waveform
                    auto& waveform = track_.getLiveRecordWaveform();
                    const int peakCount = waveform.getTotalPeaks();
                    if (peakCount > 0)
                    {
                        std::vector<float> snapMins, snapMaxs;
                        int snapCount = 0;
                        waveform.snapshotPeaks(snapMins, snapMaxs, snapCount);

                        if (snapCount > 0)
                        {
                            const float cy    = rr.getCentreY();
                            const float halfH = rr.getHeight() * 0.5f * 0.82f;
                            const double pxPerPeak = pxPerSample_ * (double)waveform.getSamplesPerPeak();
                            const float waveColAlpha = 0.80f;

                            g.saveState();
                            g.reduceClipRegion(rr.toNearestIntEdges());
                            g.setColour(juce::Colours::white.withAlpha(waveColAlpha));

                            for (int i = 0; i < snapCount; ++i)
                            {
                                const float px = rx + (float)(i * pxPerPeak);
                                if (px > rr.getRight()) break;
                                const float mn = snapMins[(size_t)i];
                                const float mx = snapMaxs[(size_t)i];
                                const float barTop    = cy - mx * halfH;
                                const float barBottom = cy - mn * halfH;
                                const float barH = juce::jmax(1.f, barBottom - barTop);
                                const float barW = juce::jmax(1.f, (float)pxPerPeak - 0.4f);
                                g.fillRect(px, barTop, barW, barH);
                            }
                            g.restoreState();
                        }
                    }

                    // Pulsing border
                    float pulse = 0.5f + 0.5f * std::sin((float)juce::Time::getMillisecondCounter() * 0.005f);
                    g.setColour(juce::Colour(0xFFFF3333).withAlpha(0.5f + pulse * 0.4f));
                    g.drawRoundedRectangle(rr, 4.f, 2.f);

                    // "REC" label
                    g.setColour(juce::Colours::white.withAlpha(0.9f));
                    g.setFont(t.fonts.small);
                    g.drawText("REC", rr.reduced(6.f, 2.f), juce::Justification::centredLeft);
                }
            }
        }

        paintAutomationOverlay(g);

        g.restoreState(); // end timeline clip region

        // ── Duplicate ghosts (Alt+drag) ─────────────────────────────────────
        if (onGetDuplicateGhosts)
        {
            auto ghosts = onGetDuplicateGhosts();
            if (!ghosts.empty())
            {
                auto& theme = Theme::getInstance();
                const float dashLen[] = { 4.f, 3.f };
                const float gy = 4.f;
                const float gh = (float)getHeight() - 8.f;
                for (const auto& ghost : ghosts)
                {
                    if (ghost.trackId != track_.getID())
                        continue;

                    juce::Rectangle<float> ghostRect(ghost.x, gy, ghost.width, gh);
                    // Skip if fully outside horizontal view
                    if (ghostRect.getRight() < 0.f || ghostRect.getX() > (float)getWidth())
                        continue;

                    if (ghost.horizontalMode)
                    {
                        const float x1 = ghostRect.getX();
                        const float x2 = ghostRect.getRight();
                        const float y1 = ghostRect.getY();
                        const float y2 = ghostRect.getBottom();

                        g.setColour(theme.colors.accent.withAlpha(0.40f));
                        g.drawDashedLine({ x1, y1, x1, y2 }, dashLen, 2, 1.3f);
                        g.drawDashedLine({ x2, y1, x2, y2 }, dashLen, 2, 1.3f);

                        g.setColour(theme.colors.accent.withAlpha(0.06f));
                        g.fillRect(ghostRect.withTrimmedLeft(1.f).withTrimmedRight(1.f));
                    }
                    else
                    {
                        g.setColour(juce::Colours::white.withAlpha(0.08f));
                        g.fillRoundedRectangle(ghostRect, 4.f);
                        juce::Path ghostPath;
                        ghostPath.addRoundedRectangle(ghostRect, 4.f);
                        juce::Path dashedGhost;
                        juce::PathStrokeType(1.4f).createDashedStroke(dashedGhost, ghostPath, dashLen, 2);
                        g.setColour(theme.colors.accent.withAlpha(0.65f));
                        g.fillPath(dashedGhost);
                    }
                }
            }
        }

        g.setColour(resizeHover_ ? t.colors.accent.withAlpha(0.55f) : t.colors.border.withAlpha(0.2f));
        g.fillRect(0.f, (float)getHeight() - 3.f, (float)getWidth(), 3.f);
    }

    void mouseMove(const juce::MouseEvent& e) override
    {
        updateAutomationHover(e.position.toFloat());
        if (hoveredAutomationPoint_ >= 0)
        {
            setMouseCursor(juce::MouseCursor::PointingHandCursor);
            hoveredTensionSegment_ = -1;
            return;
        }

        // Tension handle hover
        {
            const int seg = hitTestTensionHandle(e.position.toFloat());
            if (seg != hoveredTensionSegment_)
            {
                hoveredTensionSegment_ = seg;
                repaint();
            }
            if (seg >= 0)
            {
                setMouseCursor(juce::MouseCursor::UpDownResizeCursor);
                return;
            }
        }

        if (e.y >= getHeight() - 5)
        { if (!resizeHover_) { resizeHover_ = true; repaint(); }
          setMouseCursor(juce::MouseCursor::UpDownResizeCursor); return; }
        resizeHover_ = false;
        const auto activeTool = onGetEditTool ? onGetEditTool() : EditTool::Select;
        const float kEdge = kClipEdgeHitW;
        for (auto* clip : clipManager_.getClipsOnTrack(track_.getID()))
        {
            auto clipRect = getClipBounds(*clip);
            const float cx = clipRect.getX();
            const float cw = clipRect.getWidth();

            if (activeTool == EditTool::Select)
            {
                if (auto* audioClip = dynamic_cast<AudioClip*>(clip))
                {
                    if (getFadeHandleHitBounds(clipRect, *audioClip, true).contains(e.position.toFloat())
                        || getFadeHandleHitBounds(clipRect, *audioClip, false).contains(e.position.toFloat()))
                    {
                        setMouseCursor(getFadeHandleHitBounds(clipRect, *audioClip, true).contains(e.position.toFloat())
                            ? getFadeInCursor()
                            : getFadeOutCursor());
                        return;
                    }
                }
            }

            if (e.x >= cx - kEdge && e.x <= cx + kEdge && cx >= kStripW)
                { setMouseCursor(juce::MouseCursor::LeftEdgeResizeCursor); return; }
            if (e.x >= cx + cw - kEdge && e.x <= cx + cw + kEdge)
                { setMouseCursor(juce::MouseCursor::RightEdgeResizeCursor); return; }
            if (e.x > cx + kEdge && e.x < cx + cw - kEdge && e.y > 4.f)
            {
                if (activeTool == EditTool::Blade)
                    { setMouseCursor(getBladeCursor()); return; }
                if (activeTool == EditTool::Eraser)
                    { setMouseCursor(getEraserCursor()); return; }
                if (activeTool == EditTool::Mute)
                    { setMouseCursor(getMuteCursor()); return; }
                setMouseCursor(juce::MouseCursor::DraggingHandCursor); return;
            }
        }
        // No clip under cursor — use tool-appropriate cursor for the lane
        if (activeTool == EditTool::Blade)
            { setMouseCursor(getBladeCursor()); return; }
        if (activeTool == EditTool::Eraser)
            { setMouseCursor(getEraserCursor()); return; }
        if (activeTool == EditTool::Mute)
            { setMouseCursor(getMuteCursor()); return; }
        setMouseCursor(juce::MouseCursor::NormalCursor);
    }

    void mouseDown(const juce::MouseEvent& e) override
    {
        grabKeyboardFocus();
        if (getParentComponent()) getParentComponent()->grabKeyboardFocus();
        bubblegumMarqueeCandidate_ = false;
        bubblegumMarqueeActive_ = false;
        if (colorStripBounds_.contains(e.position))
            { TrackColorPalette::show(track_, *this, getScreenBounds().withWidth(8)); return; }

        // ── Automation selector header ────────────────────────────────────────
        if (track_.isAutomationVisible() && getAutomationSelectorBounds().contains(e.position.toFloat()))
        {
            if (e.mods.isRightButtonDown())
                showAutomationClearMenu();
            else
                showAutomationParameterSelectorMenu();
            return;
        }

        if (e.y >= getHeight() - 5)
            { if (!track_.isMaster()) { clipDragMode_ = ClipDragMode::HeightResize; dragStartY_ = e.getScreenY(); } return; }
        const float kEdge = kClipEdgeHitW;
        const auto activeTool = onGetEditTool ? onGetEditTool() : EditTool::Select;
        DBG("[TrackLane] mouseDown with active tool: " << (int)activeTool);

        if (tryBeginAutomationPointDrag(e))
            return;

        // ── Tension handle: left-drag or right-click segment menu ───────────
        {
            const int seg = hitTestTensionHandle(e.position.toFloat());
            if (seg >= 0)
            {
                auto* lane = (automation_ != nullptr)
                    ? automation_->findLane(track_.getID(), getActiveAutomationParameterId())
                    : nullptr;
                if (lane != nullptr)
                {
                    if (e.mods.isRightButtonDown())
                    {
                        showTensionHandleMenu(seg);
                        return;
                    }
                    tensionDragSegment_     = seg;
                    tensionDragStartY_      = e.getScreenY();
                    tensionDragStartValue_  = lane->points[(size_t)seg].tensionToNext;
                    tensionDragActive_      = true;
                    grabKeyboardFocus();
                    repaint();
                    return;
                }
            }
        }

        for (auto* clip : clipManager_.getClipsOnTrack(track_.getID()))
        {
            auto clipRect = getClipBounds(*clip);
            const float cx = clipRect.getX();
            const float cw = clipRect.getWidth();
            if (clip->getType() == ClipType::MIDI && cw > 28.f)
            {
                auto pr = juce::Rectangle<float>(clipRect.getRight() - 24.f, clipRect.getY() + 4.f, 18.f, 14.f);
                if (pr.contains(e.position.toFloat()))
                {
                    if (auto* midiClip = dynamic_cast<MidiClip*>(clip); midiClip != nullptr && onOpenMidiClip)
                        onOpenMidiClip(*midiClip);
                    return;
                }
            }
            if (clipRect.contains(e.position.toFloat()))
            {
                if (activeTool == EditTool::Select)
                {
                    if (auto* audioClip = dynamic_cast<AudioClip*>(clip))
                    {
                        if (getFadeHandleHitBounds(clipRect, *audioClip, true).contains(e.position.toFloat()))
                        {
                            clipDragMode_ = ClipDragMode::ClipFadeIn;
                            beginClipDrag(clip, e);
                            repaint();
                            return;
                        }

                        if (getFadeHandleHitBounds(clipRect, *audioClip, false).contains(e.position.toFloat()))
                        {
                            clipDragMode_ = ClipDragMode::ClipFadeOut;
                            beginClipDrag(clip, e);
                            repaint();
                            return;
                        }
                    }
                }

                if (activeTool == EditTool::Eraser)
                {
                    CommandManager::getInstance().execute(std::make_unique<DeleteClipCommand>(clipManager_, clip->getID()));
                    state_.selectedClipID.setValue("");
                    repaint();
                    return;
                }

                if (activeTool == EditTool::Blade)
                {
                    // Cut exactly at mouse position — no grid snap for blade tool
                    const SamplePosition splitPos = juce::jlimit(
                        clip->getStartPosition() + (SamplePosition)1,
                        clip->getEndPosition()   - (SamplePosition)1,
                        (SamplePosition)(((double)e.x - kStripW + scrollX_) / pxPerSample_));

                    if (splitPos > clip->getStartPosition() && splitPos < clip->getEndPosition())
                    {
                        const juce::String origId = clip->getID();
                        const auto originalStart = clip->getStartPosition();
                        const auto originalEnd   = clip->getEndPosition();
                        const auto originalLen   = clip->getLength();
                        const auto originalSrcOffset = clip->getSourceOffset();
                        const auto originalMuted = clip->isMuted();
                        const auto originalState = clip->getState();
                        auto leftState  = clip->getState();
                        auto rightState = clip->getState();

                        juce::String originalSourceFile;
                        if (auto* audioClip = dynamic_cast<AudioClip*>(clip))
                            originalSourceFile = audioClip->getSourceFile().getFullPathName();

                        const auto splitPoint = splitPos;
                        const auto leftLen  = splitPoint - originalStart;
                        const auto rightLen = originalEnd - splitPoint;
                        const bool autoFadeOnSplit = static_cast<bool>(state_.autoFadeOnClipSplit.getValue());
                        const auto autoFadeSamples = (SamplePosition) std::round(sampleRate_ * (kAutoFadeOnSplitMs * 0.001));
                        const auto leftFadeOutLen = autoFadeOnSplit ? juce::jmin(leftLen, autoFadeSamples) : (SamplePosition) 0;
                        const auto rightFadeInLen = autoFadeOnSplit ? juce::jmin(rightLen, autoFadeSamples) : (SamplePosition) 0;

                        // Convert engine-domain leftLen to source-file samples for sourceOffset
                        SamplePosition rightSrcOffset = originalSrcOffset;
                        if (audioFiles_)
                        {
                            double srcRate = audioFiles_->getSourceSampleRate(origId);
                            double ratio   = srcRate / juce::jmax(1.0, sampleRate_);
                            rightSrcOffset = originalSrcOffset
                                           + (SamplePosition)std::round((double)leftLen * ratio);
                        }
                        else
                        {
                            rightSrcOffset = originalSrcOffset + leftLen;
                        }

                        leftState.setProperty("startPosition", (int64_t)originalStart,   nullptr);
                        leftState.setProperty("length",        (int64_t)leftLen,         nullptr);
                        rightState.setProperty("startPosition",(int64_t)splitPoint,      nullptr);
                        rightState.setProperty("length",       (int64_t)rightLen,        nullptr);
                        rightState.setProperty("sourceOffset", (int64_t)rightSrcOffset,  nullptr);
                        if (leftState.hasProperty("fadeOutLength"))
                            leftState.setProperty("fadeOutLength",  (int64_t)leftFadeOutLen, nullptr);
                        if (rightState.hasProperty("fadeInLength"))
                            rightState.setProperty("fadeInLength",  (int64_t)rightFadeInLen, nullptr);

                        DBG("===== SPLIT DEBUG START =====");
                        DBG("Original ID=" << origId);
                        DBG("Original file=" << originalSourceFile);
                        DBG("Original start=" << (int64_t)originalStart);
                        DBG("Original len=" << (int64_t)originalLen);
                        DBG("Original end=" << (int64_t)originalEnd);
                        DBG("Original sourceStartSample=" << (int64_t)originalSrcOffset);
                        DBG("Original muted=" << (int)originalMuted);

                        // Remove the original clip first
                        CommandManager::getInstance().execute(
                            std::make_unique<DeleteClipCommand>(clipManager_, origId));

                        // Create the two new clips (they get new IDs)
                        auto* leftClip  = clipManager_.recreateClipFromState(leftState);
                        auto* rightClip = clipManager_.recreateClipFromState(rightState);

                        if (leftClip == nullptr || rightClip == nullptr)
                        {
                            DBG("[Blade] FAILED: could not recreate one or both split clips");

                            if (leftClip != nullptr)
                                clipManager_.deleteClip(leftClip->getID());
                            if (rightClip != nullptr)
                                clipManager_.deleteClip(rightClip->getID());

                            auto* restored = clipManager_.recreateClipFromState(originalState);
                            if (restored != nullptr && audioFiles_)
                            {
                                if (!audioFiles_->hasAudio(restored->getID()) && originalSourceFile.isNotEmpty())
                                    audioFiles_->loadForClip(restored->getID(), juce::File(originalSourceFile));
                            }

                            repaint();
                            return;
                        }

                        // Share the original audio cache with both new clip IDs
                        // so the engine finds the audio immediately — no reload needed
                        if (audioFiles_)
                        {
                            if (leftClip)
                                audioFiles_->shareForClip(origId, leftClip->getID());
                            if (rightClip)
                                audioFiles_->shareForClip(origId, rightClip->getID());

                            if (leftClip && !audioFiles_->hasAudio(leftClip->getID()) && originalSourceFile.isNotEmpty())
                                audioFiles_->loadForClip(leftClip->getID(), juce::File(originalSourceFile));

                            if (rightClip && !audioFiles_->hasAudio(rightClip->getID()) && originalSourceFile.isNotEmpty())
                                audioFiles_->loadForClip(rightClip->getID(), juce::File(originalSourceFile));
                        }

                        if (leftClip != nullptr)
                        {
                            leftClip->setStartPosition(originalStart);
                            leftClip->setLength(leftLen);
                            leftClip->setSourceOffset(originalSrcOffset);
                            if (auto* leftAudioClip = dynamic_cast<AudioClip*>(leftClip))
                                leftAudioClip->setFadeOutLength(leftFadeOutLen);
                        }

                        if (rightClip != nullptr)
                        {
                            rightClip->setStartPosition(splitPoint);
                            rightClip->setLength(rightLen);
                            rightClip->setSourceOffset(rightSrcOffset);
                            if (auto* rightAudioClip = dynamic_cast<AudioClip*>(rightClip))
                                rightAudioClip->setFadeInLength(rightFadeInLen);
                        }

                        DBG("Left ID=" << (leftClip ? leftClip->getID() : juce::String("FAILED")));
                        DBG("Left file=" << originalSourceFile);
                        DBG("Left start=" << (int64_t)originalStart);
                        DBG("Left len=" << (int64_t)leftLen);
                        DBG("Left end=" << (int64_t)(originalStart + leftLen));
                        DBG("Left sourceStartSample=" << (int64_t)originalSrcOffset);
                        DBG("Left hasAudio=" << (int)((audioFiles_ && leftClip) ? audioFiles_->hasAudio(leftClip->getID()) : 0));

                        DBG("Right ID=" << (rightClip ? rightClip->getID() : juce::String("FAILED")));
                        DBG("Right file=" << originalSourceFile);
                        DBG("Right start=" << (int64_t)splitPoint);
                        DBG("Right len=" << (int64_t)rightLen);
                        DBG("Right end=" << (int64_t)(splitPoint + rightLen));
                        DBG("Right sourceStartSample=" << (int64_t)rightSrcOffset);
                        DBG("Right hasAudio=" << (int)((audioFiles_ && rightClip) ? audioFiles_->hasAudio(rightClip->getID()) : 0));
                        DBG("left start: " << (int64_t)originalStart);
                        DBG("left len: " << (int64_t)leftLen);
                        DBG("left end: " << (int64_t)(originalStart + leftLen));
                        DBG("right start: " << (int64_t)splitPoint);
                        DBG("right len: " << (int64_t)rightLen);
                        DBG("right end: " << (int64_t)(splitPoint + rightLen));
                        DBG("gap: " << (int64_t)(splitPoint - (originalStart + leftLen)));
                        DBG("===== SPLIT DEBUG END =====");

                        repaint();
                    }
                    return;
                }

                if (activeTool == EditTool::Mute)
                {
                    CommandManager::getInstance().execute(std::make_unique<ClipPropertyChangeCommand>(
                        clipManager_, clip->getID(), ClipPropertyChangeCommand::Property::Muted,
                        clip->isMuted(), !clip->isMuted(), clip->isMuted() ? "Unmute Clip" : "Mute Clip"));
                    repaint();
                    return;
                }
            }
            if (e.x >= cx - kEdge && e.x <= cx + kEdge && cx >= kStripW)
                { clipDragMode_ = ClipDragMode::ClipLeftEdge;  beginClipDrag(clip, e); return; }
            if (e.x >= cx + cw - kEdge && e.x <= cx + cw + kEdge)
                { clipDragMode_ = ClipDragMode::ClipRightEdge; beginClipDrag(clip, e); return; }
            juce::Rectangle<float> body(cx + kEdge, 4.f, cw - kEdge * 2.f, (float)getHeight() - 8.f);
            if (body.contains(e.position.toFloat()))
            {
                state_.selectedClipID.setValue(clip->getID());
                if (e.mods.isRightButtonDown()) { showClipContextMenu(clip); return; }
                clipDragMode_ = ClipDragMode::ClipBody;
                beginClipDrag(clip, e);
                pendingDuplicate_ = e.mods.isShiftDown();
                duplicateSpawned_ = false;
                spawnedClipIds_.clear();
                repaint();
                return;
            }
        }
        clipDragMode_ = ClipDragMode::None;
        state_.selectedTrackID.setValue(track_.getID());
        state_.selectedClipID.setValue("");
        if (onClearClipSelection) onClearClipSelection();

        // Right-click on empty lane → show paste menu if clipboard has something
        if (e.mods.isRightButtonDown() && activeTool == EditTool::Select)
        {
            const double clickSample = (juce::jmax(0.0, (double)e.x - kStripW) + scrollX_) / pxPerSample_;
            showEmptyLaneContextMenu((SamplePosition)clickSample);
            repaint();
            return;
        }

        if (activeTool == EditTool::Select && e.mods.isLeftButtonDown() && !e.mods.isPopupMenu() && e.x >= kStripW)
        {
            if (track_.isAutomationVisible() && automation_ != nullptr)
            {
                addAutomationPointAt(e.position.toFloat());
                if (selectedAutomationPoint_ >= 0)
                    draggingAutomationPoint_ = true;
                return;
            }

            bubblegumMarqueeCandidate_ = true;
            bubblegumMarqueeStart_ = e.position.toFloat();
        }
        repaint();
    }

    void mouseDrag(const juce::MouseEvent& e) override
    {
        // ── Tension handle drag ────────────────────────────────────────────
        if (tensionDragActive_ && tensionDragSegment_ >= 0)
        {
            auto* lane = (automation_ != nullptr)
                ? automation_->findLane(track_.getID(), getActiveAutomationParameterId())
                : nullptr;
            if (lane != nullptr && tensionDragSegment_ < (int)lane->points.size())
            {
                // Tension handle is segment metadata, not an automation point:
                // drag direction follows the screen: up moves the handle/curve up,
                // down moves it down. Endpoint value/time never changes.
                float delta = (float)(e.getScreenY() - tensionDragStartY_) / 120.0f;
                if (e.mods.isCtrlDown())
                    delta *= 0.2f;
                automation_->getOrCreateLane(track_.getID(), getActiveAutomationParameterId())
                    .setTensionToNext(tensionDragSegment_, tensionDragStartValue_ + delta);
                if (automation_) automation_->publishSnapshot();
                repaint();
            }
            return;
        }

        if (draggingAutomationPoint_)
        {
            dragAutomationPoint(e.position.toFloat());
            return;
        }

        if (clipDragMode_ == ClipDragMode::HeightResize && dragStartY_ >= 0 && onHeightDrag)
            { int d = e.getScreenY() - dragStartY_; dragStartY_ = e.getScreenY(); onHeightDrag(this, d); return; }
        if (!draggedClip_)
        {
            if (bubblegumMarqueeCandidate_ && e.mods.isLeftButtonDown())
            {
                const auto dragDistance = e.position.toFloat().getDistanceFrom(bubblegumMarqueeStart_);
                if (!bubblegumMarqueeActive_ && dragDistance > 4.0f)
                {
                    bubblegumMarqueeActive_ = true;
                    if (onBubblegumSelectionBegin)
                        onBubblegumSelectionBegin(this, bubblegumMarqueeStart_);
                }

                if (bubblegumMarqueeActive_ && onBubblegumSelectionDrag)
                    onBubblegumSelectionDrag(this, e.position.toFloat());
            }
            return;
        }
        if (clipDragMode_ == ClipDragMode::ClipFadeIn || clipDragMode_ == ClipDragMode::ClipFadeOut)
        {
            applyFadeDrag(e.position.x);
        }
        else if (clipDragMode_ == ClipDragMode::ClipRightEdge)
        {
            if (!edgeResizeActivated_)
            {
                if (std::abs(e.getScreenX() - dragStartScreenX_) <= kEdgeResizeStartThresholdPx)
                {
                    repaint();
                    return;
                }
                edgeResizeActivated_ = true;
                dragOrigStart_ = draggedClip_->getStartPosition();
                dragOrigLen_ = draggedClip_->getLength();
            }
            applyEdgeResize(e.position.x);
        }
        else if (clipDragMode_ == ClipDragMode::ClipLeftEdge)
        {
            if (!edgeResizeActivated_)
            {
                if (std::abs(e.getScreenX() - dragStartScreenX_) <= kEdgeResizeStartThresholdPx)
                {
                    repaint();
                    return;
                }
                edgeResizeActivated_ = true;
                dragOrigStart_ = draggedClip_->getStartPosition();
                dragOrigLen_ = draggedClip_->getLength();
            }
            applyEdgeResize(e.position.x);
        }
        else if (clipDragMode_ == ClipDragMode::ClipBody)
        {
            auto dxPx = e.getScreenX() - dragStartScreenX_;
            auto dyPx = e.getScreenY() - dragStartScreenY_;

            if (bodyDragAxis_ == BodyDragAxis::Undecided
                && std::abs(dxPx) <= kBodyDragStartThresholdPx
                && std::abs(dyPx) <= kBodyDragStartThresholdPx)
            {
                repaint();
                return;
            }

            if (bodyDragAxis_ == BodyDragAxis::Undecided
                && (std::abs(dxPx) > kBodyDragStartThresholdPx || std::abs(dyPx) > kBodyDragStartThresholdPx))
            {
                // Spawn duplicates on first real movement if Alt was held at mouseDown
                if (pendingDuplicate_ && !duplicateSpawned_)
                    spawnDuplicates();

                // Bias toward horizontal: vertical needs 2x the movement to win
                bodyDragAxis_ = (std::abs(dyPx) > std::abs(dxPx) * 2)
                    ? BodyDragAxis::Vertical
                    : BodyDragAxis::Horizontal;

                if (duplicateSpawned_)
                {
                    const bool horizontalMode = (bodyDragAxis_ == BodyDragAxis::Horizontal);
                    for (auto& ghost : duplicateGhostRects_)
                        ghost.horizontalMode = horizontalMode;
                }

                if (bodyDragAxis_ == BodyDragAxis::Vertical && !lockHorizontal_)
                    draggedClip_->setStartPosition(dragOrigStart_);
            }

            if (!lockHorizontal_ && bodyDragAxis_ != BodyDragAxis::Vertical)
            {
                double mouseSample = juce::jmax(0.0, ((double)e.position.x - kStripW + scrollX_) / pxPerSample_);
                applyBodyDrag(mouseSample);
            }

            // Only cross lanes when axis is explicitly Vertical
            if (bodyDragAxis_ == BodyDragAxis::Vertical)
            {
                if (groupClipDragActive_ && onGroupClipCrossLane)
                    onGroupClipCrossLane(draggedClip_, getOriginalGroupTracks(), e.getScreenY());
                else if (onClipCrossLane)
                    onClipCrossLane(draggedClip_, e.getScreenY());
            }

            // Real-time color preview: apply destination track colour while dragging
            if (bodyDragAxis_ == BodyDragAxis::Vertical && onGetDragPreviewColor)
            {
                auto previewColor = onGetDragPreviewColor(e.getScreenY());
                dragPreviewColor_ = previewColor;
                if (previewColor.getAlpha() > 0)
                    draggedClip_->setColor(previewColor);
            }
        }
        repaint();
        // Repaint all lanes so ghosts show on tracks other than this one
        if (duplicateSpawned_ && onRepaintAllLanes)
            onRepaintAllLanes();
    }

    void mouseUp(const juce::MouseEvent&) override
    {
        if (bubblegumMarqueeActive_ && onBubblegumSelectionEnd)
            onBubblegumSelectionEnd();
        bubblegumMarqueeCandidate_ = false;
        bubblegumMarqueeActive_ = false;
        // ── Finish tension drag ────────────────────────────────────────────
        if (tensionDragActive_)
        {
            tensionDragActive_   = false;
            tensionDragSegment_  = -1;
            if (automation_) automation_->publishSnapshot();
            repaint();
            return;
        }

        draggingAutomationPoint_ = false;
        stopTimer();
        // Push undo command if clip was actually modified
        if (draggedClip_ && (clipDragMode_ == ClipDragMode::ClipBody
                          || clipDragMode_ == ClipDragMode::ClipLeftEdge
                          || clipDragMode_ == ClipDragMode::ClipRightEdge
                          || clipDragMode_ == ClipDragMode::ClipFadeIn
                          || clipDragMode_ == ClipDragMode::ClipFadeOut))
        {
            if (groupClipDragActive_ && groupClipDragStates_.size() > 1)
            {
                std::vector<MultiClipStateEditCommand::ClipStatePair> states;
                states.reserve(groupClipDragStates_.size());
                for (const auto& original : groupClipDragStates_)
                {
                    if (auto* clip = clipManager_.getClip(original.id))
                    {
                        auto afterState = clip->getState();
                        if (!original.beforeState.isEquivalentTo(afterState))
                            states.push_back({ original.id, original.beforeState, afterState });
                    }
                }

                if (!states.empty())
                {
                    CommandManager::getInstance().execute(std::make_unique<MultiClipStateEditCommand>(
                        clipManager_, std::move(states), "Edit Clips", true));
                }
            }
            else
            {
                auto beforeState = draggedClipBeforeState_;
                auto afterState = draggedClip_->getState();
                if (!beforeState.isEquivalentTo(afterState))
                {
                    CommandManager::getInstance().execute(std::make_unique<ClipStateEditCommand>(
                        clipManager_, draggedClip_->getID(), beforeState, afterState, "Edit Clip", true));
                }
            }
        }
        dragPreviewColor_ = juce::Colour();
        edgeResizeActivated_ = false;
        bodyDragAxis_ = BodyDragAxis::Undecided;
        groupClipDragActive_ = false;
        groupClipDragStates_.clear();
        pendingDuplicate_ = false;
        duplicateSpawned_ = false;
        spawnedClipIds_.clear();
        duplicateGhostRects_.clear();
        dragStartY_ = -1;
        clipDragMode_ = ClipDragMode::None;
        draggedClip_ = nullptr;
        // Clear ghosts on all lanes after drop
        if (onRepaintAllLanes)
            onRepaintAllLanes();
    }

    void mouseDoubleClick(const juce::MouseEvent& e) override
    {
        // Right-button double-click must never create clips — it's used for context menus
        if (e.mods.isRightButtonDown() || e.mods.isPopupMenu()) return;

        if (colorStripBounds_.contains(e.position)) return;
        if (track_.isMaster()) return;  // master bus: no clip creation
        if (hitTestAutomationSelector(e.position.toFloat()))
        {
            automationSelectorMouseDown_ = false;
            showAutomationTargetMenu();
            repaint(getAutomationSelectorBounds().expanded(6.0f).toNearestInt());
            return;
        }
        if (track_.isAutomationVisible() && automation_ != nullptr)
        {
            addAutomationPointAt(e.position.toFloat());
            return;
        }

        for (auto* clip : clipManager_.getClipsOnTrack(track_.getID()))
        {
            auto clipRect = getClipBounds(*clip);
            if (clipRect.contains(e.position.toFloat()))
            {
                if (auto* audioClip = dynamic_cast<AudioClip*>(clip))
                {
                    if (isInFadeHandleZone(clipRect, *audioClip, e.position.toFloat()))
                    {
                        auto beforeState = audioClip->getState();
                        const bool resetFadeIn = getFadeHandleHitBounds(clipRect, *audioClip, true).contains(e.position.toFloat());
                        if (resetFadeIn)
                            audioClip->setFadeInLength(0);
                        else
                            audioClip->setFadeOutLength(0);

                        auto afterState = audioClip->getState();
                        if (!beforeState.isEquivalentTo(afterState))
                        {
                            CommandManager::getInstance().execute(std::make_unique<ClipStateEditCommand>(
                                clipManager_, audioClip->getID(), beforeState, afterState,
                                resetFadeIn ? "Reset Fade In" : "Reset Fade Out", true));
                        }
                        repaint();
                        return;
                    }
                }

                if (onOpenClipProperties)
                    onOpenClipProperties(*clip);
                return;
            }
        }
        double clickSample = (juce::jmax(0.0, (double)e.x - kStripW) + scrollX_) / pxPerSample_;
        SamplePosition sp = snapToGrid(juce::jmax((SamplePosition)0, (SamplePosition)clickSample));
        SamplePosition bl = (SamplePosition)(sampleRate_ * 60.0 / bpm_ * 4.0);
        const auto clipType = (track_.getRole() == TrackRole::MIDI || track_.getRole() == TrackRole::Instrument)
            ? ClipType::MIDI
            : ClipType::Audio;
        auto addCmd = std::make_unique<AddClipCommand>(clipManager_, track_.getID(), clipType == ClipType::MIDI ? "MIDI Clip" : "Clip", clipType, sp, bl * 2, track_.getColor().brighter(0.1f));
        auto* addCmdRaw = addCmd.get();
        CommandManager::getInstance().execute(std::move(addCmd));
        if (auto* c = clipManager_.getClip(addCmdRaw->getClipId()))
        {
            state_.selectedClipID.setValue(c->getID());
            repaint();
        }
    }

    void mouseExit(const juce::MouseEvent&) override
    {
        resizeHover_ = false; showToolGuide_ = false;
        hoveredAutomationPoint_ = -1;
        hoveredTensionSegment_ = -1;
        setMouseCursor(juce::MouseCursor::NormalCursor);
        repaint();
    }

    bool keyPressed(const juce::KeyPress& key) override
    {
        if ((key == juce::KeyPress::deleteKey || key == juce::KeyPress::backspaceKey)
            && selectedAutomationPoint_ >= 0)
        {
            const auto deleteParamId = getActiveAutomationParameterId();
            if (isSendLevelAutomationParameter(deleteParamId))
            {
                const auto routeID = getSendRouteIdFromAutomationParameter(deleteParamId);
                apex::automation::AutomationArrangementBridge::getInstance()
                    .removeSendLevelBreakpoint(track_.getID(), routeID, selectedAutomationPoint_);
                selectedAutomationPoint_ = -1;
                hoveredAutomationPoint_ = -1;
                repaint();
                return true;
            }
            if (isSendBypassAutomationParameter(deleteParamId))
            {
                const auto routeID = getSendRouteIdFromAutomationParameter(deleteParamId);
                apex::automation::AutomationArrangementBridge::getInstance()
                    .removeSendBypassBreakpoint(track_.getID(), routeID, selectedAutomationPoint_);
                selectedAutomationPoint_ = -1;
                hoveredAutomationPoint_ = -1;
                repaint();
                return true;
            }
            if (automation_ != nullptr)
            {
                automation_->removePoint(track_.getID(), deleteParamId, selectedAutomationPoint_);
                selectedAutomationPoint_ = -1;
                hoveredAutomationPoint_ = -1;
                repaint();
                return true;
            }
        }

        return false;
    }

private:
    Track&               track_;
    ClipManager&         clipManager_;
    ApplicationState&    state_;
    MarkerManager*       markers_ = nullptr;
    TransportController& transport_;
    AudioFileManager*    audioFiles_ = nullptr;
    AutomationManagerCore* automation_ = nullptr;
    double pxPerSample_ = 0.00005, scrollX_ = 0.0, bpm_ = 120.0, sampleRate_ = 44100.0;
    int    laneIndex_ = 0, height_ = 72, dragStartY_ = -1, dragStartScreenY_ = 0, dragStartScreenX_ = 0;
    bool   resizeHover_ = false, lockHorizontal_ = false;
    bool   waveformDetailEnabled_ = true;
    bool   fastScrollMode_ = false;
    bool   gridCacheDirty_ = true;
    SnapMode snapMode_ = SnapMode::Bar_1;
    juce::Colour dragPreviewColor_;
    SamplePosition recordStartPos_ = 0;
    mutable juce::Rectangle<float> colorStripBounds_;
    mutable juce::Image gridTile_;
    mutable double gridTileZoom_ = -1.0, gridTileBpm_ = -1.0, gridTileSR_ = -1.0;
    mutable int gridTileW_ = 0, gridTileH_ = 0;
    mutable juce::Image gridWide_;
    mutable int gridWideViewW_ = 0;
    std::unordered_set<juce::String> multiSelectedClipIDs_;

    bool          edgeResizeActivated_ = false;
    BodyDragAxis  bodyDragAxis_ = BodyDragAxis::Undecided;
    ClipDragMode   clipDragMode_  = ClipDragMode::None;
    Clip*          draggedClip_   = nullptr;
    float          hoverToolX_    = -1.f;
    bool           showToolGuide_ = false;
    SamplePosition dragOrigStart_ = 0, dragOrigLen_ = 0;
    SamplePosition dragOrigSourceOffset_ = 0;
    double         dragMouseOffsetSamples_ = 0.0;
    juce::ValueTree draggedClipBeforeState_;
    juce::Array<Clip*> observedClips_;
    struct GroupClipDragState
    {
        ClipID id;
        juce::ValueTree beforeState;
        SamplePosition start = 0;
        SamplePosition length = 0;
        SamplePosition sourceOffset = 0;
        TrackID trackId;
        SamplePosition fadeInLength = 0;
        SamplePosition fadeOutLength = 0;
        double sourceSamplesPerTimelineSample = 1.0;
    };
    std::vector<GroupClipDragState> groupClipDragStates_;
    bool groupClipDragActive_ = false;
    bool pendingDuplicate_ = false;
    bool duplicateSpawned_ = false;
    std::vector<ClipID> spawnedClipIds_;
    std::vector<DuplicateGhostRect> duplicateGhostRects_;
    juce::ValueTree clipboardState_;
    std::vector<AutomationPoint> automationClipboard_;
    int selectedAutomationPoint_ = -1;
    int hoveredAutomationPoint_ = -1;
    AutomationCurveType defaultAutomationCurve_ = AutomationCurveType::Linear;
    bool automationFreeDrawMode_ = true;
    bool draggingAutomationPoint_ = false;
    bool automationLineHover_ = false;
    bool automationSelectorHover_ = false;
    bool automationSelectorMouseDown_ = false;
    juce::Point<float> automationSelectorMouseDownPos_;
    bool bubblegumMarqueeCandidate_ = false;
    bool bubblegumMarqueeActive_ = false;
    juce::Point<float> bubblegumMarqueeStart_;
    mutable juce::Rectangle<float> automationSelectorBounds_;

    // --- Add missing member variables for automation and layout ---
    juce::Rectangle<int> rulerBounds_;
    double zoom_ = 0.00008;
    int tensionDragSegment_ = -1;
    bool tensionDragActive_ = false;
    int hoveredTensionSegment_ = -1;
    float tensionDragStartValue_ = 0.0f;
    int tensionDragStartY_ = 0;

    juce::Rectangle<int> toolbarBounds_;
    mutable juce::Image toolbarCache_;
    SnapMode toolbarCacheSnap_ = SnapMode::Bar_1;
    bool toolbarCacheLock_ = false;
    EditTool toolbarCacheTool_ = EditTool::Select;
    int toolbarCacheW_ = 0, toolbarCacheH_ = 0;
    EditTool currentTool_ = EditTool::Select;

    // --- Add missing function stub declarations ---
    void syncClipListeners();
    void clearClipListeners();
    void paintCachedGrid(juce::Graphics&);
    void drawClipFades(juce::Graphics&, const juce::Rectangle<float>&, const AudioClip&);
    juce::Rectangle<float> getClipBounds(const Clip&) const;
    void beginClipDrag(Clip*, const juce::MouseEvent&);
    juce::Rectangle<float> getFadeHandleHitBounds(const juce::Rectangle<float>&, const AudioClip&, bool) const;
    juce::MouseCursor getBladeCursor() const;
    juce::MouseCursor getEraserCursor() const;
    juce::MouseCursor getMuteCursor() const;
    void applyFadeDrag(float) {}
    bool isInFadeHandleZone(const juce::Rectangle<float>&, const AudioClip&, juce::Point<float>) const { return false; }
    bool tryBeginAutomationPointDrag(const juce::MouseEvent&) { return false; }
    void dragAutomationPoint(juce::Point<float>) {}
    void showTensionHandleMenu(int) {}
    void showEmptyLaneContextMenu(SamplePosition) {}
    void applyBodyDrag(SamplePosition) {}
    SamplePosition snapToGrid(SamplePosition s) const { return s; }
    juce::MouseCursor getFadeInCursor() const { return juce::MouseCursor::NormalCursor; }
    float getDefaultAutomationValueForActiveTarget() const { return 0.0f; }

    /** Cached toolbar — only rebuild when snap/lock/size/hover changes. */
    void drawCachedToolbar(juce::Graphics& g)
    {
        const int tw = juce::jmax(1, toolbarBounds_.getWidth());
        const int th = juce::jmax(1, toolbarBounds_.getHeight());
        bool mouseOverToolbar = toolbarBounds_.toFloat().contains(getMouseXYRelative().toFloat());
        bool dirty = !toolbarCache_.isValid()
                     || toolbarCacheSnap_ != snapMode_
                     || toolbarCacheLock_ != lockHorizontal_
                     || toolbarCacheTool_ != currentTool_
                     || toolbarCacheW_ != tw || toolbarCacheH_ != th
                     || mouseOverToolbar; // hover effects need live rendering

        if (dirty)
        {
            toolbarCache_ = juce::Image(juce::Image::ARGB, tw, th, true);
            juce::Graphics tg(toolbarCache_);
            tg.setOrigin(-toolbarBounds_.getX(), -toolbarBounds_.getY());
            drawSnapToolbar(tg);
            toolbarCacheSnap_ = snapMode_;
            toolbarCacheLock_ = lockHorizontal_;
            toolbarCacheTool_ = currentTool_;
            toolbarCacheW_ = tw; toolbarCacheH_ = th;
        }
        g.drawImageAt(toolbarCache_, toolbarBounds_.getX(), toolbarBounds_.getY());
    }

    void drawMarkerFlags(juce::Graphics& g)
    {
        if (markers_ == nullptr)
            return;

        auto& t = Theme::getInstance(); auto rb = rulerBounds_.toFloat();
        for (int i = 0; i < markers_->getNumMarkers(); ++i)
        {
            auto* m = markers_->getMarker(i);
            float x = (float)(m->position * zoom_ - scrollX_);
            if (x < 0.f || x > (float)getWidth()) continue;
            g.setColour(m->color.withAlpha(0.8f)); g.fillRect(x, rb.getY(), 1.5f, rb.getHeight());
            float lw = t.fonts.small.getStringWidthFloat(m->name) + 10.f;
            auto fr = juce::Rectangle<float>(x + 1.f, rb.getY() + 1.f, lw, 16.f);
            g.setColour(m->color.withAlpha(0.85f)); g.fillRoundedRectangle(fr, 3.f);
            g.setColour(juce::Colours::white); g.setFont(t.fonts.small);
            g.drawText(m->name, fr.reduced(4.f, 0.f), juce::Justification::centredLeft);
            if (m->length > 0)
                { g.setColour(m->color.withAlpha(0.05f)); g.fillRect(x, rb.getBottom(), (float)(m->length * zoom_), (float)(getHeight() - rb.getBottom())); }
        }
    }

    void clearClipListeners() {}
    void paintCachedGrid(juce::Graphics&) {}
    void drawClipFades(juce::Graphics&, const juce::Rectangle<float>&, const AudioClip&) {}
    juce::Rectangle<float> getClipBounds(const Clip&) const { return {}; }
    void beginClipDrag(Clip*, const juce::MouseEvent&) {}
    juce::Rectangle<float> getFadeHandleHitBounds(const juce::Rectangle<float>&, const AudioClip&, bool) const { return {}; }
    juce::MouseCursor getBladeCursor() const { return juce::MouseCursor::NormalCursor; }
    juce::MouseCursor getEraserCursor() const { return juce::MouseCursor::NormalCursor; }
    juce::MouseCursor getMuteCursor() const { return juce::MouseCursor::NormalCursor; }
    void applyFadeDrag(float) {}
    bool isInFadeHandleZone(const juce::Rectangle<float>&, const AudioClip&, juce::Point<float>) const { return false; }
    bool tryBeginAutomationPointDrag(const juce::MouseEvent&) { return false; }
    void dragAutomationPoint(juce::Point<float>) {}
    void showTensionHandleMenu(int) {}
    void showEmptyLaneContextMenu(SamplePosition) {}
    void applyBodyDrag(SamplePosition) {}
    SamplePosition snapToGrid(SamplePosition s) const { return s; }
    juce::MouseCursor getFadeInCursor() const { return juce::MouseCursor::NormalCursor; }
    float getDefaultAutomationValueForActiveTarget() const { return 0.0f; }

    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR(TrackLane)
};

class ArrangementView : public juce::Component
{
public:
    ArrangementView(TrackManager& trackManager,
                    ClipManager& clipManager,
                    ApplicationState& state,
                    MarkerManager& markers,
                    TransportController& transport,
                    AudioFileManager* audioFiles = nullptr,
                    AutomationManagerCore* automation = nullptr)
        : trackManager_(trackManager), clipManager_(clipManager), state_(state),
          markers_(markers), transport_(transport), audioFiles_(audioFiles), automation_(automation)
    {
    }

    void setPluginChainProvider(std::function<PluginChainCore*(const TrackID&)> provider) { pluginChainProvider_ = std::move(provider); }
    void setRoutingGraphProvider(std::function<RoutingGraph*()> provider) { routingGraphProvider_ = std::move(provider); }

    int getVerticalScrollOffset() const noexcept { return verticalScrollOffset_; }
    int getNumLanes() const noexcept
    {
        return trackManager_.getNumTracks() + (trackManager_.hasMasterTrack() ? 1 : 0);
    }

    int getLaneHeight(int index) const
    {
        if (index < 0)
            return defaultLaneHeight_;
        auto it = laneHeights_.find(index);
        return it != laneHeights_.end() ? it->second : defaultLaneHeight_;
    }

    void setLaneHeight(int index, int newHeight)
    {
        if (index < 0)
            return;
        newHeight = juce::jlimit(24, 2000, newHeight);
        laneHeights_[index] = newHeight;
        if (onLaneHeightChanged)
            onLaneHeightChanged(index, newHeight);
        if (onLaneLayoutChanged)
            onLaneLayoutChanged();
        repaint();
    }

    void setMultiSelectedClips(const std::vector<juce::String>& ids)
    {
        multiSelectedClipIDs_.clear();
        multiSelectedClipIDs_.insert(ids.begin(), ids.end());
        repaint();
    }

    void setCollapsedFolders(const std::unordered_set<TrackID>& collapsed)
    {
        collapsedFolders_ = collapsed;
        repaint();
    }

    void setKeepWaveformsVisibleWhileScrolling(bool enabled)
    {
        keepWaveformsVisibleWhileScrolling_ = enabled;
        repaint();
    }

    std::function<void(int,int)> onLaneHeightChanged;
    std::function<void(int)> onVerticalScrollChanged;
    std::function<void()> onLaneLayoutChanged;
    std::function<void()> onSendToBubble;
    std::function<void(MidiClip&)> onOpenMidiClip;
    std::function<void(const std::vector<juce::String>&, bool)> onBoxSelectionCommitted;
    std::function<void()> onClipSelectionCleared;
    std::function<void(Clip&)> onOpenClipProperties;
    std::function<void()> onOpenSelectedClipProperties;
    std::function<void()> onOpenSelectedMidiClip;
    std::function<void()> onQuickAccessSidePanel;
    std::function<void()> onQuickAccessFxBrowser;

private:
    TrackManager& trackManager_;
    ClipManager& clipManager_;
    ApplicationState& state_;
    MarkerManager& markers_;
    TransportController& transport_;
    AudioFileManager* audioFiles_ = nullptr;
    AutomationManagerCore* automation_ = nullptr;

    std::function<PluginChainCore*(const TrackID&)> pluginChainProvider_;
    std::function<RoutingGraph*()> routingGraphProvider_;

    std::unordered_map<int, int> laneHeights_;
    std::unordered_set<juce::String> multiSelectedClipIDs_;
    std::unordered_set<TrackID> collapsedFolders_;
    int verticalScrollOffset_ = 0;
    int defaultLaneHeight_ = 72;
    bool keepWaveformsVisibleWhileScrolling_ = false;

    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR(ArrangementView)
};

} // namespace DAW
